# ===========================================
# 服务配置
# ===========================================
# 监听端口（容器内固定 3000，此处仅影响宿主机映射）
PORT=3000

# ===========================================
# 数据路径（所有数据统一在 ./data/ 目录下）
# ===========================================
# SQLite 数据库路径
DATABASE_PATH=./data/wechat.db

# KV 存储驱动与路径（存储登录凭证等）
NITRO_KV_DRIVER=fs
NITRO_KV_BASE=./data/kv

# 请求日志目录（仅 NUXT_DEBUG_MP_REQUEST=true 时写入）
LOG_DIR=./data/logs

# ===========================================
# 调试
# ===========================================
# 记录微信代理请求详情（仅开发环境生效）
NUXT_DEBUG_MP_REQUEST=false
DEBUG_KEY=

# ===========================================
# 第三方服务（可选）
# ===========================================
# AG Grid 企业版授权
NUXT_AGGRID_LICENSE=

# ===========================================
# AI 分析服务（爆文解析、内容生成等功能）
# ===========================================
# 以下为默认 fallback 配置，推荐在设置页面中通过 UI 配置模型
# 支持 OpenAI 兼容接口的服务商：
#   智谱 GLM:   https://open.bigmodel.cn/api/paas/v4  模型: glm-5
#   DeepSeek:   https://api.deepseek.com/v1           模型: deepseek-chat
#   阿里云百炼:  https://dashscope.aliyuncs.com/compatible-mode/v1  模型: qwen-plus
#   月之暗面:    https://api.moonshot.cn/v1            模型: moonshot-v1-8k
#   OpenAI:     https://api.openai.com/v1             模型: gpt-4o-mini
AI_API_KEY=
AI_API_BASE=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-5

# ===========================================
# 邮箱 IMAP 配置（每日话题功能）
# ===========================================
# IMAP 服务器地址
EMAIL_IMAP_HOST=imap.qq.com
# IMAP 端口
EMAIL_IMAP_PORT=993
# 邮箱账号
EMAIL_USER=
# 授权码（非登录密码，需在邮箱设置中开启 IMAP 并生成）
EMAIL_PASS=

# ===========================================
# Tavily 搜索 API（素材搜集功能，可选）
# ===========================================
# 注册 https://tavily.com 获取免费 API Key（1000次/月）
TAVILY_API_KEY=

# ===========================================
# Serper.dev 图片搜索 API（推荐，Google Images 搜索）
# ===========================================
# 注册 https://serper.dev 获取 API Key
# 按量付费：$0.30/千次，适合时政/科技类全网搜图
SERPER_API_KEY=

# ===========================================
# Pexels 图片搜索 API（免费素材库，推荐情感/生活类）
# ===========================================
# 注册 https://www.pexels.com/api/ 获取免费 API Key
# 免费额度：20,000 次/月
PEXELS_API_KEY=

# ===========================================
# Google Custom Search（旧方案，兼容保留）
# ===========================================
GOOGLE_SEARCH_KEY=
GOOGLE_CX=
